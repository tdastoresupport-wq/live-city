# LIVE CITY Local Server & Bridge Configuration
# Copy to .env for local runs. NEVER commit .env or live tokens.

# Local authoritative server bind host and port
LIVE_CITY_HOST=127.0.0.1
LIVE_CITY_PORT=4000

# Optional static operator token (leave empty in dev to auto-generate ephemeral CSPRNG token)
LIVE_CITY_OPERATOR_TOKEN=

# Optional comma-separated exact CORS origin allowlist (dev/preview origins added by default)
LIVE_CITY_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:4173,http://127.0.0.1:5173

# External TikTok Webcast Bridge configuration (optional)
# Leave empty to run with interactive Mock Simulator / Dashboard
TIKTOK_BRIDGE_URL=
TIKTOK_REQUIRE_ACK=true
LIVE_CITY_ALLOW_LOOPBACK_BRIDGE=true
# Required only when connecting to non-loopback wss:// bridge hosts
LIVE_CITY_ALLOWED_BRIDGE_HOSTS=
