# LIVE CITY — LOCAL ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env for custom local configuration. Never commit .env!

# Host binding (Default: 127.0.0.1 for local loopback security)
LIVE_CITY_HOST=127.0.0.1

# Standalone Game Server Port (Default: 4000)
LIVE_CITY_PORT=4000

# Optional custom operator token (Generated automatically at runtime if left blank)
LIVE_CITY_OPERATOR_TOKEN=

# Optional local TikTok LIVE Webcast Bridge URL (e.g. ws://127.0.0.1:21213)
TIKTOK_BRIDGE_URL=
